rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if owns(userId);
      allow create, delete: if false;
      allow update: if owns(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nickname', 'nativeLanguage', 'targetLanguage', 'level', 'updatedAt'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 40
        && request.resource.data.nativeLanguage != request.resource.data.targetLanguage
        && request.resource.data.level in ['A1', 'A2', 'B1', 'B2', 'C1'];

      match /lessons/{lessonId} {
        allow read: if owns(userId);
        allow create, delete: if false;
        allow update: if owns(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['completed', 'updatedAt'])
          && request.resource.data.completed == true;
      }

      match /dailyUsage/{date} {
        allow read: if owns(userId);
        allow write: if false;
      }

      match /devices/{deviceId} {
        allow read: if owns(userId);
        allow write: if false;
      }

      match /recentTopics/{topicId} {
        allow read: if owns(userId);
        allow write: if false;
      }

      match /phrases/{phraseId} {
        allow read: if owns(userId);
        allow write: if false;
      }

      match /skillReviews/{pair}/items/{itemId} {
        allow read: if owns(userId);
        allow create, update: if owns(userId)
          && pair.matches('^[a-z]{2,3}-[A-Z]{2}_[a-z]{2,3}-[A-Z]{2}$')
          && itemId.matches('^[a-f0-9]{16}$')
          && validSkillReview(request.resource.data);
      }
    }

    function validSkillReview(data) {
      return data.keys().hasOnly(['attemptId', 'lastRating', 'lastMode', 'recallRating', 'reviewedAt', 'dueAt', 'intervalDays'])
        && data.keys().hasAll(['attemptId', 'lastRating', 'lastMode', 'recallRating', 'reviewedAt', 'dueAt', 'intervalDays'])
        && data.attemptId is string && data.attemptId.size() == 36
        && data.lastRating in ['got-it', 'almost', 'forgot']
        && data.lastMode in ['recall', 'recognition']
        && (data.recallRating == null || data.recallRating in ['got-it', 'almost', 'forgot'])
        && (data.lastMode != 'recall' || data.recallRating == data.lastRating)
        && data.reviewedAt is int && data.reviewedAt >= 0
        && data.intervalDays is int && data.intervalDays >= 1 && data.intervalDays <= 32
        && data.dueAt is int && data.dueAt == data.reviewedAt + data.intervalDays * 86400000;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
