# Lesson text is Vertex AI Gemini on the Firebase project below. Do not put a Gemini or OpenAI key here.
# Production Firebase project. Override in an EAS environment for any other project.
# The iOS plist and Android google-services.json must belong to this same project.
EXPO_PUBLIC_FIREBASE_PROJECT_ID=resolingo
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=resolingo.firebasestorage.app
# Native google-services.json / GoogleService-Info.plist are what the app loads.
# Android com.resolingo.app: 1:168640425089:android:d2148d985606955459b180
# iOS com.resolingo.app: 1:168640425089:ios:3fa21043c368503659b180
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=resolingo.firebaseapp.com
# Defaults live in apps/mobile/app.config.ts. Set these only to point at another Expo project.
EXPO_OWNER=amanjaiswal03
EXPO_PUBLIC_EAS_PROJECT_ID=89e3143e-acd3-47b4-95ff-3c131a3f2535
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=168640425089-9rt7kh4f1sil6p7cphd8jojvhr8da0p3.apps.googleusercontent.com
EXPO_PUBLIC_USE_EMULATORS=false
# Dev App Check debug token. Put the real value in apps/mobile/.env.local (gitignored), then restart Metro.
# EXPO_PUBLIC_APP_CHECK_DEBUG_TOKEN=
